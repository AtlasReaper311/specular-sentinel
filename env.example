# specular-sentinel environment
# Install copy lives at /etc/specular-sentinel/env, root:root, chmod 600.
#
# INFRA_REPORT_KEY is a secret. It is set in exactly two places: here,
# and at an interactive `wrangler secret put INFRA_REPORT_KEY` prompt in
# atlas-api-public. It never appears in chat, scripts, or shell history;
# any exposure anywhere else means immediate rotation in both places.
INFRA_REPORT_KEY=

# Everything below has working defaults for SPECULAR-CORE and only needs
# touching if the topology changes.
REPORT_URL=https://api.atlas-systems.uk/v1/infra/report
OLLAMA_URL=http://127.0.0.1:11434
CORPUS_URL=http://127.0.0.1:8092
TIMEOUT_SECONDS=6
CANARY_QUERY=specular sentinel canary
